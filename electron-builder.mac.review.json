{
  "appId": "com.broadcast.game.review",
  "productName": "BroadcastGame Review",
  "extraMetadata": {
    "broadcastBuildProfile": "review"
  },
  "directories": {
    "output": "dist-electron-mac-review"
  },
  "asar": true,
  "files": [
    "dist/**/*",
    "!dist/characters/**",
    "!dist/chapter_assets/**",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "build/game.dat",
      "to": "game.dat"
    }
  ],
  "mac": {
    "icon": "build/icon.png",
    "category": "public.app-category.games",
    "target": [
      "dmg",
      "zip"
    ],
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "BroadcastGame Review"
  }
}
