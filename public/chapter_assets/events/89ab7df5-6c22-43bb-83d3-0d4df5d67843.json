          "w": 0.23177083333333337,
          "h": 0.2916666666666667,
          "blur": 2
        }
      ],
      "blurDefault": 4
    },
    {
      "id": "node_1787133586562_51_u7yy",
      "type": "text",
      "speakerType": "narrator",
      "speaker": "",
      "text": "내 자지가 그녀의 보지를 뒤에서 밀어 넣는다.",
      "text_key": "node_1787133586562_51_u7yy"
    },
    {
      "id": "node_1787133586562_52_vder",
      "type": "text",
      "speakerType": "character",
      "speaker": "1786851109772-o2n3dj3",
      "text": "깊어요… 사장님, 제 안 깊은 곳까지…",
      "text_key": "node_1787133586562_52_vder",
      "voice": "node_1787133586562_52_vder.wav",
      "sound": "node_1787133586562_52_vder.wav"
    },
    {
      "id": "node_1787133586562_53_5fo2",
      "type": "text",
      "speakerType": "player",
      "speaker": "player",
      "text": "으읏……",
      "text_key": "node_1787133586562_53_5fo2"
    },
    {
      "id": "node_1787133586562_54_soqg",
      "type": "text",
      "speakerType": "narrator",
      "speaker": "",
      "text": "그녀의 보지가 내 자지를 꽉 조이고, 애액이 허벅지를 타고 흘러내린다.",
      "text_key": "node_1787133586562_54_soqg"
    },
    {
      "id": "node_1787133586562_55_do6e",
      "type": "text",
      "speakerType": "character",
      "speaker": "1786851109772-o2n3dj3",
      "text": "좋아요… 더 세게…",
      "text_key": "node_1787133586562_55_do6e",
      "voice": "node_1787133586562_55_do6e.wav",
      "sound": "node_1787133586562_55_do6e.wav"
    },
    {
      "id": "node_1787133586562_56_o5ls",
      "type": "text",
      "speakerType": "player",
      "speaker": "player",
      "text": "아…… 센노 씨… 나… 이제…",
      "text_key": "node_1787133586562_56_o5ls"
    },
    {
      "id": "node_1787133586562_57_w3k8",
      "type": "text",
      "speakerType": "character",
      "speaker": "1786851109772-o2n3dj3",
      "text": "나와요, 사장님. 저도 갈 거예요.",
      "text_key": "node_1787133586562_57_w3k8",
      "voice": "node_1787133586562_57_w3k8.wav",
      "sound": "node_1787133586562_57_w3k8.wav"
    },
    {
      "id": "node_1787133586562_58_em00",
      "type": "text",
      "speakerType": "player",
      "speaker": "player",
      "text": "아…… 나온다……!",
      "text_key": "node_1787133586562_58_em00"
    },
    {
      "id": "node_1787133586562_59_m21a",
      "type": "text",
      "speakerType": "character",
      "speaker": "1786851109772-o2n3dj3",
      "text": "사장님… 저도…",
      "text_key": "node_1787133586562_59_m21a",
      "voice": "node_1787133586562_59_m21a.wav",
      "sound": "node_1787133586562_59_m21a.wav"
    },
    {
      "id": "node_1788401326134_5zq2",
      "type": "sound",
      "role": "sfx",
      "sound": "node_1787133586562_59_m21a.wav",
      "loop": false,
      "stop": true
    },
    {
      "id": "node_1787135064374_956j",
      "type": "graphic",
      "image": "e06ff069-71b5-4ea5-a7f1-5581e810ea38.webp",
      "delay": 2,
      "blurRegions": [
        {
          "id": "blur_1788408499426_pmcm",
          "x": 0.7330729166666666,
          "y": 0.4542824074074074,
          "w": 0.08072916666666674,
          "h": 0.28472222222222227,
          "blur": 1.5
        }
      ],
      "blurDefault": 4
    },
    {
      "id": "node_1787133586562_61_8lwq",
      "type": "text",
      "speakerType": "narrator",
      "speaker": "",
      "text": "그녀가 소파에 엎드린 채, 나는 마지막 남은 정액을 그녀의 등과 엉덩이, 성기 부위와 몸 위에 쏟아낸다. 온몸이 정액으로 뒤덮인다.",
      "text_key": "node_1787133586562_61_8lwq"
    },
    {
      "id": "node_1787133586562_62_8sj7",
      "type": "text",
      "speakerType": "character",
      "speaker": "1786851109772-o2n3dj3",
      "text": "하…… 사장님의… 전부…",
      "text_key": "node_1787133586562_62_8sj7",
      "voice": "node_1787133586562_62_8sj7.wav",
      "sound": "node_1787133586562_62_8sj7.wav"
    },
    {
      "id": "node_1787133586562_63_9nmp",
      "type": "text",
      "speakerType": "player",
      "speaker": "player",
      "text": "하…… 하……",
      "text_key": "node_1787133586562_63_9nmp"
    },
    {
      "id": "node_1787133586562_64_8jpn",
      "type": "text",
      "speakerType": "character",
      "speaker": "1786851109772-o2n3dj3",
      "text": "정말, 대단했어요.",
      "text_key": "node_1787133586562_64_8jpn",
      "voice": "node_1787133586562_64_8jpn.wav",
      "sound": "node_1787133586562_64_8jpn.wav"
    }
  ],
