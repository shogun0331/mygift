      "type": "text",
      "speakerType": "character",
      "speaker": "1786849140255-p0lxz2i",
      "text": "…대단하세요.",
      "text_key": "node_1787118693734_58_t5br",
      "voice": "node_1787118693734_58_t5br.wav",
      "sound": "node_1787118693734_58_t5br.wav"
    },
    {
      "id": "node_1787118693734_59_7ipb",
      "type": "text",
      "speakerType": "narrator",
      "speaker": "",
      "text": "부끄러워하며 입꼬리를 올린다.",
